{
  "$schema": "https://opencode.ai/theme.json",
  "base": {
    "categorical": [
      "purple",
      "cyan",
      "orange",
      "green",
      "yellow",
      "blue",
      "red"
    ],
    "text": {
      "base": "#FFFFFF",
      "muted": "#999999",
      "action": {
        "primary": {
          "base": "$text.base",
          "$disabled": "$text.muted",
          "$focused": "#000000",
          "$selected": "$hue.interactive.200"
        },
        "secondary": {
          "base": "$text.muted",
          "$hovered": "$text.base"
        },
        "destructive": {
          "base": "#000000",
          "$disabled": "$text.muted"
        }
      },
      "formfield": {
        "base": "$text.base",
        "$hovered": "$hue.interactive.200",
        "$focused": "$hue.interactive.200",
        "$pressed": "$hue.interactive.200",
        "$disabled": "$text.muted",
        "$selected": "$hue.interactive.200"
      },
      "feedback": {
        "error": {
          "base": "#FF6B80"
        },
        "warning": {
          "base": "#FFC107"
        },
        "success": {
          "base": "#4EBA65"
        },
        "info": {
          "base": "#4782C8"
        }
      }
    },
    "background": {
      "base": "transparent",
      "raised": {
        "base": "$hue.band.200",
        "high": "$hue.band.300",
        "max": "$hue.band.400"
      },
      "action": {
        "primary": {
          "base": "transparent",
          "$hovered": "$hue.band.200",
          "$focused": "$hue.interactive.200",
          "$selected": "transparent"
        },
        "secondary": {
          "base": "transparent"
        },
        "destructive": {
          "base": "#FF6B80"
        }
      },
      "formfield": {
        "base": "$background.base"
      },
      "feedback": {
        "error": {
          "base": "$background.base"
        },
        "warning": {
          "base": "$background.base"
        },
        "success": {
          "base": "$background.base"
        },
        "info": {
          "base": "$background.base"
        }
      }
    },
    "border": {
      "base": "#888888"
    },
    "scrollbar": {
      "base": "#D77757"
    },
    "diff": {
      "text": {
        "added": "#4EBA65",
        "removed": "#FF6B80",
        "context": "#999999",
        "hunkHeader": "#999999"
      },
      "background": {
        "added": "#225C2B",
        "removed": "#7A2936",
        "context": "transparent"
      },
      "highlight": {
        "added": "#38A660",
        "removed": "#B3596B"
      },
      "lineNumber": {
        "text": "#999999",
        "background": {
          "added": "#47584A",
          "removed": "#69484D"
        }
      }
    },
    "syntax": {
      "comment": "#75715E",
      "keyword": "#F92672",
      "function": "#A6E22E",
      "variable": "#F8F8F2",
      "string": "#E6DB74",
      "number": "#AE81FF",
      "type": "#66D9EF",
      "operator": "#F92672",
      "punctuation": "#F8F8F2"
    },
    "markdown": {
      "text": "#FFFFFF",
      "heading": "#FFFFFF",
      "link": "#B1B9F9",
      "linkText": "#B1B9F9",
      "code": "#B1B9F9",
      "blockQuote": "#999999",
      "emphasis": "#FFFFFF",
      "strong": "#FFFFFF",
      "horizontalRule": "#505050",
      "listItem": "#FFFFFF",
      "listEnumeration": "#FFFFFF",
      "image": "#B1B9F9",
      "imageText": "#999999",
      "codeBlock": "#FFFFFF"
    },
    "@dialog": {
      "background": {
        "base": "$background.raised.base",
        "action": {
          "primary": {
            "$hovered": "$background.raised.high"
          }
        }
      }
    }
  },
  "dark": {
