{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "opencode-claude-style",
  "version": "0.1.0",
  "description": "A cosmetic OpenCode theme + CLI plugin that makes OpenCode look like Claude Code: colors, Clawd, the welcome banner, and prompt styling.",
  "type": "module",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "opencode-theme",
    "claude-code",
    "tui"
  ],
  "exports": {
    "./tui": "./src/tui.tsx"
  },
  "files": [
    "src",
    "themes",
    "scripts",
    "tui.ts",
    "README.md"
  ],
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "preview": "./scripts/preview.sh"
  },
  "peerDependencies": {
    "@opencode/plugin": ">=2.2.0 <3",
    "@opentui/core": ">=0.7.0",
    "@opentui/solid": ">=0.7.0",
    "solid-js": ">=1.9.0"
  },
  "devDependencies": {
    "@opencode/client": "2.2.0",
    "@opencode/plugin": "2.2.0",
    "@opencode/theme": "2.2.0",
    "@opentui/core": "0.7.0",
    "@opentui/solid": "0.7.0",
    "@types/bun": "^1.4.2",
    "@types/node": "^22.0.0",
    "solid-js": "1.9.12",
    "typescript": "^5.6.0"
  }
}
